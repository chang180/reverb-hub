# Site address port is Caddy's listen port inside the container (mapped host HTTP_PORT -> 80).
# Do not put the host-mapped port (e.g. 9080) here or that host will hit an empty :80 server.
{$CADDY_SITE:http://localhost} {
	encode gzip zstd
	root * /var/www/html/public

	@reverb path /app /app/* /apps /apps/*
	handle @reverb {
		reverse_proxy reverb:8080
	}

	handle {
		php_fastcgi app:9000 {
			root /var/www/html/public
		}
		file_server
	}
}
