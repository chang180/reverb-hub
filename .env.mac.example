APP_NAME="Reverb Hub"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://caddy.reverb-hub-orb.orb.local
APP_LOCALE=zh_TW
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=reverb_hub
DB_USERNAME=reverb
DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis

# Compose Redis (this file). VPS uses host Redis: REDIS_HOST=host.docker.internal
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

ADMIN_NAME=Admin
ADMIN_EMAIL=admin@reverb-hub.test
ADMIN_PASSWORD=password

# macOS + OrbStack: keep host 80/443 free for Laravel Herd.
# Do not use http://reverb-hub.test (Herd parked site in ~/Herd).
COMPOSE_PROJECT_NAME=reverb-hub-orb
COMPOSE_FILE=docker-compose.yml:docker-compose.orbstack.yml:docker-compose.local.yml
HTTP_BIND=127.0.0.1
HTTP_PORT=9080
HTTPS_PORT=9443
# Listen on container :80 (Docker publishes host 9080 -> 80). Not host:9080.
CADDY_SITE=:80
CADDY_EMAIL=

REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
REVERB_HOST=caddy.reverb-hub-orb.orb.local
REVERB_PORT=80
REVERB_SCHEME=http
REVERB_API_URL=http://reverb:8080

VITE_APP_NAME="${APP_NAME}"
